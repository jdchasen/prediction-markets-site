---
import SEOHead from "../components/SEOHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsletterPopup from "../components/NewsletterPopup.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { ADSENSE_ENABLED, ADSENSE_PUBLISHER_ID } from "../config/ads";
import "../styles/fonts.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  newsArticle?: boolean;
  pubDate?: string;
  updatedDate?: string;
}

const { title, description, image, article, newsArticle, pubDate, updatedDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      article={article}
      newsArticle={newsArticle}
      pubDate={pubDate}
      updatedDate={updatedDate}
    />
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Google Analytics (deferred to after first paint) -->
    <script is:inline>
      (function() {
        var loaded = false;
        function loadGA() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-W07DSXGL25';
          s.async = true;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-W07DSXGL25');
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA);
        } else {
          setTimeout(loadGA, 2000);
        }
      })();
    </script>
    {ADSENSE_ENABLED && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`} crossorigin="anonymous"></script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" as="font" href="/fonts/Inter-Variable-latin.woff2" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100 min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white focus:text-sm focus:font-medium">
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <NewsletterPopup />
    <SearchDialog />
  </body>
</html>
