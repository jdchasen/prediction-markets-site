---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformCTAs from '../../components/PlatformCTAs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---

<BaseLayout
  title="Prediction Market Arbitrage Calculator — Kalshi vs Polymarket"
  description="Find cross-platform arbitrage opportunities between Kalshi and Polymarket. Calculate guaranteed profits after fees with step-by-step execution instructions."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is prediction market arbitrage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prediction market arbitrage is buying contracts on two different platforms such that you profit regardless of the outcome. For example, if YES on Kalshi costs $0.45 and NO on Polymarket costs $0.50, the combined cost is $0.95 but the guaranteed payout is $1.00, locking in a $0.05 profit per contract pair."
          }
        },
        {
          "@type": "Question",
          "name": "Can you arbitrage between Kalshi and Polymarket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, cross-platform arbitrage is possible when the same event is listed on both Kalshi and Polymarket with different prices. However, you need to account for fees on both platforms, execution risk (prices may move before you fill both sides), and settlement risk (platforms may resolve the same event differently)."
          }
        },
        {
          "@type": "Question",
          "name": "How do fees affect prediction market arbitrage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fees can eliminate apparent arbitrage opportunities. Kalshi charges 7% on profits, which reduces your net payout from the winning side. An opportunity that looks profitable before fees may break even or lose money after fees. Always calculate net profit after all platform fees before executing."
          }
        },
        {
          "@type": "Question",
          "name": "What are the risks of prediction market arbitrage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Key risks include: (1) execution risk — prices may move before you fill both legs, (2) settlement risk — platforms may interpret event outcomes differently, (3) liquidity risk — you may not be able to fill the size you want at the quoted price, and (4) capital lockup — your money is tied up until settlement."
          }
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Prediction Market Arbitrage Calculator",
      "description": "Find cross-platform arbitrage opportunities between Kalshi and Polymarket.",
      "url": "https://masterpredictionmarkets.com/tools/arbitrage-scanner",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })} />
  </Fragment>

  <section class="bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-12">
    <div class="mx-auto max-w-6xl px-4">
      <nav class="mb-6 text-sm text-gray-500 dark:text-gray-400">
        <a href="/tools" class="hover:text-brand-600">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 dark:text-white">Arbitrage Scanner</span>
      </nav>
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
        Arbitrage Scanner
      </h1>
      <p class="max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        Find guaranteed-profit opportunities across Kalshi and Polymarket. Enter prices from both platforms and see if an arbitrage exists after fees.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Inputs -->
        <div class="space-y-6">
          <!-- Kalshi -->
          <div class="rounded-lg border-2 border-green-200 dark:border-green-800 bg-white dark:bg-gray-800 p-6">
            <div class="mb-4 flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-green-500"></div>
              <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Kalshi</h2>
            </div>
            <div class="space-y-4">
              <div>
                <label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">YES Price (cents)</label>
                <div class="flex items-center gap-4">
                  <input
                    type="range"
                    data-input="kalshi-yes-slider"
                    min="1" max="99" value="45"
                    class="h-2 flex-1 cursor-pointer appearance-none rounded-lg bg-gray-200 dark:bg-gray-700 accent-green-600"
                  />
                  <input
                    type="number"
                    data-input="kalshi-yes-number"
                    min="1" max="99" value="45"
                    class="w-16 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium dark:text-gray-100 focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
                  />
                </div>
              </div>
              <div>
                <label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Fee on profits</label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    data-input="kalshi-fee"
                    min="0" max="50" value="7" step="0.1"
                    class="w-20 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium dark:text-gray-100 focus:border-green-500 focus:outline-none focus:ring-1 focus:ring-green-500"
                  />
                  <span class="text-sm text-gray-500 dark:text-gray-400">%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Polymarket -->
          <div class="rounded-lg border-2 border-blue-200 dark:border-blue-800 bg-white dark:bg-gray-800 p-6">
            <div class="mb-4 flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-blue-500"></div>
              <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Polymarket</h2>
            </div>
            <div class="space-y-4">
              <div>
                <label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">YES Price (cents)</label>
                <div class="flex items-center gap-4">
                  <input
                    type="range"
                    data-input="poly-yes-slider"
                    min="1" max="99" value="52"
                    class="h-2 flex-1 cursor-pointer appearance-none rounded-lg bg-gray-200 dark:bg-gray-700 accent-blue-600"
                  />
                  <input
                    type="number"
                    data-input="poly-yes-number"
                    min="1" max="99" value="52"
                    class="w-16 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium dark:text-gray-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                </div>
              </div>
              <div>
                <label class="mb-2 block text-sm text-gray-600 dark:text-gray-400">Fee on profits</label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    data-input="poly-fee"
                    min="0" max="50" value="0" step="0.1"
                    class="w-20 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium dark:text-gray-100 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />
                  <span class="text-sm text-gray-500 dark:text-gray-400">%</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div class="space-y-4">
          <!-- Arb Result Banner -->
          <div data-output="arb-banner" class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-6 text-center">
            <p class="text-lg font-semibold text-gray-500 dark:text-gray-400">No arbitrage opportunity</p>
            <p class="mt-1 text-sm text-gray-400 dark:text-gray-500">Adjust prices to find an arb</p>
          </div>

          <!-- Execution Steps -->
          <div data-output="steps-panel" class="hidden rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Execution</h2>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 dark:bg-brand-900/50 text-xs font-bold text-brand-700 dark:text-brand-300">1</span>
                <p data-output="step1" class="text-sm text-gray-700 dark:text-gray-300">—</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 dark:bg-brand-900/50 text-xs font-bold text-brand-700 dark:text-brand-300">2</span>
                <p data-output="step2" class="text-sm text-gray-700 dark:text-gray-300">—</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 dark:bg-brand-900/50 text-xs font-bold text-brand-700 dark:text-brand-300">3</span>
                <p class="text-sm text-gray-700 dark:text-gray-300">Wait for settlement. One side pays $1.00 regardless of outcome.</p>
              </div>
            </div>
          </div>

          <!-- Scaling Table -->
          <div data-output="scaling-panel" class="hidden rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Scaling Table</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Pairs</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Total Cost</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Fees</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Net Profit</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">ROI</th>
                  </tr>
                </thead>
                <tbody data-output="scaling-table" class="divide-y divide-gray-100 dark:divide-gray-700">
                </tbody>
              </table>
            </div>
          </div>

          <!-- Caveats -->
          <div class="rounded-lg border border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 p-5">
            <h3 class="mb-2 text-sm font-semibold text-amber-800 dark:text-amber-300">Important Caveats</h3>
            <ul class="space-y-1 text-xs text-amber-700 dark:text-amber-400">
              <li><strong>Execution risk:</strong> Prices may move before you fill both legs. Always fill the less liquid side first.</li>
              <li><strong>Settlement risk:</strong> Kalshi and Polymarket may interpret ambiguous event outcomes differently.</li>
              <li><strong>Liquidity:</strong> Order book depth may not support large sizes at quoted prices.</li>
              <li><strong>Capital lockup:</strong> Your funds are tied up until the event settles, which may be weeks or months.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explanation -->
  <section class="border-t border-gray-100 dark:border-gray-700 py-12">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">How Prediction Market Arbitrage Works</h2>
      <div class="space-y-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        <p>
          Arbitrage exploits price differences between platforms. When the same event is priced differently on Kalshi and Polymarket, you can sometimes buy contracts on both sides (YES on one platform, NO on the other) for a combined cost less than $1.00. Since the payout is always $1.00 regardless of outcome, the difference is guaranteed profit.
        </p>
        <p>
          There are two directions to check. <strong>Direction 1:</strong> Buy YES on Kalshi + buy NO on Polymarket (NO price = 100 - YES price). <strong>Direction 2:</strong> Buy NO on Kalshi + buy YES on Polymarket. The scanner checks both and picks the cheaper combination.
        </p>
        <p>
          Fees are the primary arb killer. Kalshi charges 7% on profits, which reduces your net payout from the winning side. An arb that looks like 5 cents of profit pre-fees might net only 1-2 cents after fees — or nothing at all. This calculator shows you the real numbers after all fees.
        </p>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white pt-2">Practical Tips</h3>
        <p>
          Fill the less liquid side first (usually Kalshi). Use limit orders, not market orders. Check that the order book has enough depth at the quoted price. The wider the arb, the more likely it persists — tiny arbs often disappear before you can fill both sides. And always verify both platforms are pricing the exact same event with the same settlement criteria.
        </p>
      </div>

      <!-- FAQ -->
      <div class="mt-10 space-y-4">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Frequently Asked Questions</h2>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">What is prediction market arbitrage?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">Prediction market arbitrage is buying contracts on two different platforms so you profit regardless of the outcome. If the combined cost of YES on one platform and NO on the other is less than $1.00, you lock in the difference as guaranteed profit.</p>
        </details>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">Can you arbitrage between Kalshi and Polymarket?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">Yes, when the same event is listed on both platforms at different prices. Account for fees on both sides, execution risk (prices move), and settlement risk (platforms may resolve differently). Use limit orders and fill the less liquid side first.</p>
        </details>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">How do fees affect arbitrage?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">Fees can eliminate apparent arb opportunities entirely. Kalshi's 7% profit fee reduces your payout on the winning side. Always calculate net profit after all platform fees — this calculator does it for you.</p>
        </details>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">What are the risks of arbitrage?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">Key risks: execution risk (prices move before you fill both legs), settlement risk (platforms resolve differently), liquidity risk (can't fill at quoted prices), and capital lockup (money tied up until settlement). These risks are real — arbitrage is low-risk, not no-risk.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 space-y-6">
      <PlatformCTAs />
      <NewsletterForm variant="banner" />
    </div>
  </section>
</BaseLayout>

<script>
  // DOM refs
  const kalshiYesSlider = document.querySelector('[data-input="kalshi-yes-slider"]') as HTMLInputElement;
  const kalshiYesNumber = document.querySelector('[data-input="kalshi-yes-number"]') as HTMLInputElement;
  const kalshiFeeInput = document.querySelector('[data-input="kalshi-fee"]') as HTMLInputElement;
  const polyYesSlider = document.querySelector('[data-input="poly-yes-slider"]') as HTMLInputElement;
  const polyYesNumber = document.querySelector('[data-input="poly-yes-number"]') as HTMLInputElement;
  const polyFeeInput = document.querySelector('[data-input="poly-fee"]') as HTMLInputElement;

  function syncInputs(slider: HTMLInputElement, number: HTMLInputElement) {
    slider.addEventListener('input', () => { number.value = slider.value; calculate(); });
    number.addEventListener('input', () => {
      let v = Math.min(99, Math.max(1, parseInt(number.value) || 1));
      slider.value = String(v);
      calculate();
    });
  }
  syncInputs(kalshiYesSlider, kalshiYesNumber);
  syncInputs(polyYesSlider, polyYesNumber);
  kalshiFeeInput.addEventListener('input', calculate);
  polyFeeInput.addEventListener('input', calculate);

  function calculate() {
    const kalshiYes = parseInt(kalshiYesSlider.value);
    const polyYes = parseInt(polyYesSlider.value);
    const kalshiFee = Math.max(0, parseFloat(kalshiFeeInput.value) || 0) / 100;
    const polyFee = Math.max(0, parseFloat(polyFeeInput.value) || 0) / 100;

    const kalshiNo = 100 - kalshiYes;
    const polyNo = 100 - polyYes;

    // Direction 1: YES on Kalshi + NO on Polymarket
    const cost1 = kalshiYes + polyNo;
    // Direction 2: NO on Kalshi + YES on Polymarket
    const cost2 = kalshiNo + polyYes;

    // Pick cheaper direction
    let bestCost: number, direction: number;
    if (cost1 <= cost2) {
      bestCost = cost1;
      direction = 1;
    } else {
      bestCost = cost2;
      direction = 2;
    }

    // Gross profit per pair (in cents) before fees
    const grossProfit = 100 - bestCost;

    // Calculate worst-case fees
    // The winning side pays fees on profit. We don't know which wins, so compute both.
    let netProfitIfA: number, netProfitIfB: number;

    if (direction === 1) {
      // YES Kalshi + NO Poly
      // If event YES: Kalshi YES wins → profit = (100 - kalshiYes), fee on Kalshi profit
      // Poly NO loses → cost was polyNo
      const kalshiProfit = 100 - kalshiYes;
      const kalshiFeeAmt = kalshiProfit * kalshiFee;
      netProfitIfA = kalshiProfit - kalshiFeeAmt - polyNo; // net when event = YES

      // If event NO: Kalshi YES loses, Poly NO wins → profit = (100 - polyNo), fee on Poly profit
      const polyProfit = 100 - polyNo;
      const polyFeeAmt = polyProfit * polyFee;
      netProfitIfB = polyProfit - polyFeeAmt - kalshiYes; // net when event = NO
    } else {
      // NO Kalshi + YES Poly
      // If event YES: Kalshi NO loses, Poly YES wins
      const polyProfit = 100 - polyYes;
      const polyFeeAmt = polyProfit * polyFee;
      netProfitIfA = polyProfit - polyFeeAmt - kalshiNo;

      // If event NO: Kalshi NO wins, Poly YES loses
      const kalshiProfit = 100 - kalshiNo;
      const kalshiFeeAmt = kalshiProfit * kalshiFee;
      netProfitIfB = kalshiProfit - kalshiFeeAmt - polyYes;
    }

    // Guaranteed profit = minimum of both scenarios
    const netProfit = Math.min(netProfitIfA, netProfitIfB);

    const bannerEl = document.querySelector('[data-output="arb-banner"]') as HTMLElement;
    const stepsEl = document.querySelector('[data-output="steps-panel"]') as HTMLElement;
    const scalingEl = document.querySelector('[data-output="scaling-panel"]') as HTMLElement;

    if (netProfit > 0) {
      // Arb exists
      bannerEl.className = 'rounded-lg border-2 border-green-300 bg-green-50 p-6 text-center';
      bannerEl.innerHTML = `
        <p class="text-lg font-semibold text-green-700">Arbitrage found!</p>
        <p class="mt-2 text-3xl font-bold text-green-800">$${(netProfit / 100).toFixed(2)} <span class="text-base font-normal text-green-600">per pair</span></p>
        <p class="mt-1 text-sm text-green-600">$${(netProfit).toFixed(1)}¢ guaranteed profit per contract pair after fees</p>
      `;
      stepsEl.classList.remove('hidden');
      scalingEl.classList.remove('hidden');

      // Steps
      if (direction === 1) {
        setText('step1', `Buy YES on Kalshi at $0.${String(kalshiYes).padStart(2, '0')}`);
        setText('step2', `Buy NO on Polymarket at $0.${String(polyNo).padStart(2, '0')}`);
      } else {
        setText('step1', `Buy NO on Kalshi at $0.${String(kalshiNo).padStart(2, '0')}`);
        setText('step2', `Buy YES on Polymarket at $0.${String(polyYes).padStart(2, '0')}`);
      }

      // Scaling table
      const pairs = [1, 5, 10, 25, 50, 100, 250, 500, 1000];
      const tbody = document.querySelector('[data-output="scaling-table"]') as HTMLElement;
      tbody.innerHTML = '';
      for (const n of pairs) {
        const totalCost = (bestCost * n) / 100;
        const worstFee = ((bestCost * n) / 100) - (netProfit * n / 100) - totalCost + (n * 100 / 100);
        const totalNetProfit = (netProfit * n) / 100;
        const totalFees = (n * 100 / 100) - totalCost - totalNetProfit;
        const roi = (totalNetProfit / totalCost) * 100;

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="py-2 text-gray-900">${n}</td>
          <td class="py-2 text-gray-900">$${totalCost.toFixed(2)}</td>
          <td class="py-2 text-gray-500">$${totalFees.toFixed(2)}</td>
          <td class="py-2 font-medium text-green-600">+$${totalNetProfit.toFixed(2)}</td>
          <td class="py-2 text-gray-900">${roi.toFixed(1)}%</td>
        `;
        tbody.appendChild(tr);
      }
    } else if (grossProfit > 0 && netProfit <= 0) {
      // Pre-fee arb exists but fees kill it
      bannerEl.className = 'rounded-lg border-2 border-amber-200 bg-amber-50 p-6 text-center';
      bannerEl.innerHTML = `
        <p class="text-lg font-semibold text-amber-700">Arb exists pre-fees, but fees eliminate profit</p>
        <p class="mt-2 text-sm text-amber-600">Gross spread: ${grossProfit}¢ &mdash; Net after fees: ${netProfit.toFixed(1)}¢</p>
      `;
      stepsEl.classList.add('hidden');
      scalingEl.classList.add('hidden');
    } else {
      // No arb
      bannerEl.className = 'rounded-lg border border-gray-200 bg-gray-50 p-6 text-center';
      bannerEl.innerHTML = `
        <p class="text-lg font-semibold text-gray-500">No arbitrage opportunity</p>
        <p class="mt-1 text-sm text-gray-400">Combined cost: $${(bestCost / 100).toFixed(2)} &mdash; no spread to capture</p>
      `;
      stepsEl.classList.add('hidden');
      scalingEl.classList.add('hidden');
    }
  }

  function setText(key: string, value: string) {
    const el = document.querySelector(`[data-output="${key}"]`);
    if (el) el.textContent = value;
  }

  calculate();
</script>
