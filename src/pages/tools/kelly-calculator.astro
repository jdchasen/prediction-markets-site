---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformCTAs from '../../components/PlatformCTAs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---

<BaseLayout
  title="Kelly Criterion Calculator for Prediction Markets"
  description="Calculate optimal bet sizing using the Kelly criterion. Find the mathematically ideal position size for prediction market trades on Kalshi and Polymarket."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Kelly criterion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Kelly criterion is a formula for optimal bet sizing that maximizes long-term growth of your bankroll. It tells you what fraction of your bankroll to risk on a bet given the odds and your estimated probability of winning. The formula balances risk and reward to grow your account as fast as possible without risking ruin."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use full Kelly or fractional Kelly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most professional bettors use half Kelly or quarter Kelly. Full Kelly maximizes growth but assumes your probability estimates are perfectly accurate, which they rarely are. Half Kelly gives about 75% of the growth rate with much lower variance. Quarter Kelly is even more conservative and recommended for beginners."
          }
        },
        {
          "@type": "Question",
          "name": "How do I apply Kelly criterion to prediction markets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In prediction markets, the contract price determines your odds. If a YES contract costs $0.40, your potential net win is $0.60 (minus fees). Estimate the true probability of the event, plug in the numbers, and Kelly tells you what percentage of your bankroll to allocate. Remember to account for platform fees in your calculations."
          }
        }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Kelly Criterion Calculator for Prediction Markets",
      "description": "Calculate optimal bet sizing using the Kelly criterion for prediction market trades.",
      "url": "https://masterpredictionmarkets.com/tools/kelly-calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })} />
  </Fragment>

  <section class="bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-12">
    <div class="mx-auto max-w-6xl px-4">
      <nav class="mb-6 text-sm text-gray-500 dark:text-gray-400">
        <a href="/tools" class="hover:text-brand-600 dark:hover:text-brand-400">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 dark:text-white">Kelly Calculator</span>
      </nav>
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
        Kelly Criterion Calculator
      </h1>
      <p class="max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        Find the mathematically optimal bet size for any prediction market trade. Accounts for platform fees on Kalshi and Polymarket.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Inputs -->
        <div class="space-y-6">
          <!-- Bankroll -->
          <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <label class="mb-3 block text-sm font-semibold text-gray-900 dark:text-white">Bankroll ($)</label>
            <input
              type="number"
              data-input="bankroll"
              min="1" value="1000" step="100"
              class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2.5 text-sm font-medium text-gray-900 dark:text-gray-100 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
              placeholder="1000"
            />
          </div>

          <!-- Contract Price -->
          <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <label class="mb-3 block text-sm font-semibold text-gray-900 dark:text-white">Contract Price (cents)</label>
            <div class="flex items-center gap-4">
              <input
                type="range"
                data-input="price-slider"
                min="1" max="99" value="40"
                class="h-2 flex-1 cursor-pointer appearance-none rounded-lg bg-gray-200 dark:bg-gray-700 accent-brand-600"
              />
              <div class="flex items-center">
                <span class="mr-1 text-sm text-gray-500 dark:text-gray-400">$0.</span>
                <input
                  type="number"
                  data-input="price-number"
                  min="1" max="99" value="40"
                  class="w-16 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium text-gray-900 dark:text-gray-100 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                />
              </div>
            </div>
          </div>

          <!-- True Probability -->
          <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <label class="mb-3 block text-sm font-semibold text-gray-900 dark:text-white">Your True Probability (%)</label>
            <div class="flex items-center gap-4">
              <input
                type="range"
                data-input="prob-slider"
                min="1" max="99" value="55"
                class="h-2 flex-1 cursor-pointer appearance-none rounded-lg bg-gray-200 dark:bg-gray-700 accent-brand-600"
              />
              <div class="flex items-center">
                <input
                  type="number"
                  data-input="prob-number"
                  min="1" max="99" value="55"
                  class="w-16 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-center text-sm font-medium text-gray-900 dark:text-gray-100 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                />
                <span class="ml-1 text-sm text-gray-500 dark:text-gray-400">%</span>
              </div>
            </div>
          </div>

          <!-- Platform -->
          <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <label class="mb-3 block text-sm font-semibold text-gray-900 dark:text-white">Platform</label>
            <div class="flex gap-3">
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm text-gray-900 dark:text-gray-100 has-[:checked]:border-green-500 has-[:checked]:bg-green-50 dark:has-[:checked]:bg-green-900/30">
                <input type="radio" name="platform" value="kalshi" checked class="accent-green-600" />
                Kalshi (7% fee)
              </label>
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm text-gray-900 dark:text-gray-100 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-900/30">
                <input type="radio" name="platform" value="polymarket" class="accent-blue-600" />
                Polymarket
              </label>
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm text-gray-900 dark:text-gray-100 has-[:checked]:border-gray-500 has-[:checked]:bg-gray-100 dark:has-[:checked]:bg-gray-700">
                <input type="radio" name="platform" value="none" class="accent-gray-600" />
                No fees
              </label>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div class="space-y-4">
          <!-- Warning Banner -->
          <div data-output="warning" class="hidden rounded-lg border border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 p-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.072 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              <div>
                <p class="text-sm font-medium text-amber-800 dark:text-amber-300">High Kelly percentage</p>
                <p class="mt-1 text-xs text-amber-700 dark:text-amber-400">Full Kelly suggests betting &gt;25% of bankroll. This is very aggressive — consider using half or quarter Kelly to reduce variance and protect against estimation errors.</p>
              </div>
            </div>
          </div>

          <!-- No Bet Banner -->
          <div data-output="no-bet" class="hidden rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-6 text-center">
            <svg class="mx-auto mb-3 h-10 w-10 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
            <p class="text-lg font-semibold text-gray-700 dark:text-gray-300">No Bet</p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Negative expected value — Kelly says don't bet.</p>
          </div>

          <!-- Kelly Results -->
          <div data-output="results-panel" class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Optimal Bet Sizing</h2>
            <div class="space-y-4">
              <div class="rounded-md bg-brand-50 dark:bg-brand-900/30 p-4">
                <div class="text-xs font-medium uppercase text-brand-600 dark:text-brand-400">Full Kelly</div>
                <div class="mt-1 flex items-baseline gap-2">
                  <span data-output="full-pct" class="text-2xl font-bold text-gray-900 dark:text-white">—</span>
                  <span data-output="full-dollar" class="text-sm text-gray-500 dark:text-gray-400">—</span>
                </div>
                <div data-output="full-contracts" class="text-xs text-gray-500 dark:text-gray-400 mt-1">—</div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-md bg-gray-50 dark:bg-gray-800/50 p-4">
                  <div class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Half Kelly</div>
                  <div class="mt-1">
                    <span data-output="half-pct" class="text-lg font-bold text-gray-900 dark:text-white">—</span>
                  </div>
                  <div data-output="half-dollar" class="text-xs text-gray-500 dark:text-gray-400 mt-1">—</div>
                </div>
                <div class="rounded-md bg-gray-50 dark:bg-gray-800/50 p-4">
                  <div class="text-xs font-medium uppercase text-gray-500 dark:text-gray-400">Quarter Kelly</div>
                  <div class="mt-1">
                    <span data-output="quarter-pct" class="text-lg font-bold text-gray-900 dark:text-white">—</span>
                  </div>
                  <div data-output="quarter-dollar" class="text-xs text-gray-500 dark:text-gray-400 mt-1">—</div>
                </div>
              </div>
              <hr class="border-gray-100 dark:border-gray-700" />
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-600 dark:text-gray-400">Edge</span>
                  <span data-output="edge" class="text-sm font-medium">—</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-600 dark:text-gray-400">Expected growth (full Kelly)</span>
                  <span data-output="growth" class="text-sm font-medium">—</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Risk Table -->
          <div data-output="risk-table-panel" class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Risk Comparison</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Fraction</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Bet Size</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Contracts</th>
                    <th class="pb-2 font-medium text-gray-500 dark:text-gray-400">Growth</th>
                  </tr>
                </thead>
                <tbody data-output="risk-table" class="divide-y divide-gray-100 dark:divide-gray-700">
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explanation -->
  <section class="border-t border-gray-100 dark:border-gray-700 py-12">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">How the Kelly Criterion Works</h2>
      <div class="space-y-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        <p>
          The Kelly criterion, developed by John Kelly at Bell Labs in 1956, answers a fundamental question: given a bet with positive expected value, how much should you wager? Bet too little and you leave growth on the table. Bet too much and a losing streak can devastate your bankroll.
        </p>
        <p>
          The formula finds the fraction of your bankroll that maximizes the expected logarithm of wealth — in other words, the fastest long-term growth rate. For a simple binary bet, the Kelly fraction is: <strong>f = (bp - q) / b</strong>, where b is the net odds (profit per dollar risked), p is the probability of winning, and q = 1 - p is the probability of losing.
        </p>
        <p>
          In prediction markets, b = ((1 - price) × (1 - feeRate)) / price. So a $0.40 contract on Kalshi has b = (0.60 × 0.93) / 0.40 = 1.395. If you think the true probability is 55%, Kelly recommends f = (1.395 × 0.55 - 0.45) / 1.395 = 22.7% of your bankroll.
        </p>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white pt-2">Why Use Fractional Kelly?</h3>
        <p>
          Full Kelly assumes your probability estimate is perfectly accurate. In practice, it almost never is. Half Kelly (betting half of what Kelly recommends) achieves about 75% of the optimal growth rate but with significantly less variance. Quarter Kelly is even smoother. Most professional traders use half Kelly as a baseline and adjust down for uncertainty.
        </p>
      </div>

      <!-- FAQ -->
      <div class="mt-10 space-y-4">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Frequently Asked Questions</h2>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">What is the Kelly criterion?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">The Kelly criterion is a formula for optimal bet sizing that maximizes long-term growth of your bankroll. It tells you what fraction to risk on each bet given the odds and your estimated probability of winning, balancing growth and risk of ruin.</p>
        </details>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">Should I use full Kelly or fractional Kelly?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">Most professionals use half or quarter Kelly. Full Kelly maximizes growth but assumes your probability estimates are perfect. Half Kelly gives ~75% of the growth rate with much lower variance and is the most common recommendation.</p>
        </details>
        <details class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-900 dark:text-white">How do I apply Kelly to prediction markets?</summary>
          <p class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400">The contract price determines your odds. A $0.40 YES contract gives net odds of (0.60 × (1 - fee)) / 0.40. Estimate the true probability, plug in the values, and Kelly tells you what fraction of your bankroll to risk. Account for platform fees — Kalshi charges 7% on profits.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 space-y-6">
      <PlatformCTAs />
      <NewsletterForm variant="banner" />
    </div>
  </section>
</BaseLayout>

<script>
  const bankrollInput = document.querySelector('[data-input="bankroll"]') as HTMLInputElement;
  const priceSlider = document.querySelector('[data-input="price-slider"]') as HTMLInputElement;
  const priceNumber = document.querySelector('[data-input="price-number"]') as HTMLInputElement;
  const probSlider = document.querySelector('[data-input="prob-slider"]') as HTMLInputElement;
  const probNumber = document.querySelector('[data-input="prob-number"]') as HTMLInputElement;
  const platformRadios = document.querySelectorAll('input[name="platform"]') as NodeListOf<HTMLInputElement>;

  function syncInputs(slider: HTMLInputElement, number: HTMLInputElement) {
    slider.addEventListener('input', () => { number.value = slider.value; calculate(); });
    number.addEventListener('input', () => {
      let v = Math.min(99, Math.max(1, parseInt(number.value) || 1));
      slider.value = String(v);
      calculate();
    });
  }
  syncInputs(priceSlider, priceNumber);
  syncInputs(probSlider, probNumber);
  bankrollInput.addEventListener('input', calculate);
  platformRadios.forEach(r => r.addEventListener('change', calculate));

  function getFeeRate(): number {
    const platform = (document.querySelector('input[name="platform"]:checked') as HTMLInputElement)?.value || 'kalshi';
    if (platform === 'kalshi') return 0.07;
    return 0;
  }

  function calculate() {
    const bankroll = Math.max(1, parseFloat(bankrollInput.value) || 1000);
    const price = parseInt(priceSlider.value);
    const trueProb = parseInt(probSlider.value) / 100;
    const feeRate = getFeeRate();
    const cost = price / 100;

    // b = net odds = net profit per $1 contract / cost
    const netWinPerContract = (1 - cost) * (1 - feeRate);
    const b = netWinPerContract / cost;

    // Kelly fraction: f = (b*p - q) / b
    const p = trueProb;
    const q = 1 - p;
    const kellyRaw = (b * p - q) / b;
    const kelly = Math.max(0, kellyRaw);

    const warningEl = document.querySelector('[data-output="warning"]') as HTMLElement;
    const noBetEl = document.querySelector('[data-output="no-bet"]') as HTMLElement;
    const resultsEl = document.querySelector('[data-output="results-panel"]') as HTMLElement;
    const riskTableEl = document.querySelector('[data-output="risk-table-panel"]') as HTMLElement;

    if (kelly <= 0) {
      // No bet
      noBetEl.classList.remove('hidden');
      resultsEl.classList.add('hidden');
      riskTableEl.classList.add('hidden');
      warningEl.classList.add('hidden');
      return;
    }

    noBetEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');
    riskTableEl.classList.remove('hidden');

    // Warning if > 25%
    warningEl.classList.toggle('hidden', kelly <= 0.25);

    const half = kelly / 2;
    const quarter = kelly / 4;

    const fullDollar = kelly * bankroll;
    const halfDollar = half * bankroll;
    const quarterDollar = quarter * bankroll;

    const fullContracts = Math.floor(fullDollar / cost);
    const halfContracts = Math.floor(halfDollar / cost);
    const quarterContracts = Math.floor(quarterDollar / cost);

    setText('full-pct', (kelly * 100).toFixed(1) + '%');
    setText('full-dollar', '$' + fullDollar.toFixed(2));
    setText('full-contracts', fullContracts + ' contracts');

    setText('half-pct', (half * 100).toFixed(1) + '%');
    setText('half-dollar', '$' + halfDollar.toFixed(2));

    setText('quarter-pct', (quarter * 100).toFixed(1) + '%');
    setText('quarter-dollar', '$' + quarterDollar.toFixed(2));

    // Edge = trueProb - breakeven
    const breakeven = cost / (cost + (1 - cost) * (1 - feeRate));
    const edge = trueProb - breakeven;
    setText('edge', (edge * 100).toFixed(1) + '%');
    setColor('edge', edge >= 0 ? 'text-green-600' : 'text-red-600');

    // Expected log growth for full Kelly: E[log] = p * log(1 + f*b) + q * log(1 - f)
    const expectedGrowth = p * Math.log(1 + kelly * b) + q * Math.log(1 - kelly);
    setText('growth', (expectedGrowth * 100).toFixed(3) + '% per bet');

    // Risk comparison table
    const fractions = [
      { label: 'Full Kelly', frac: kelly },
      { label: '¾ Kelly', frac: kelly * 0.75 },
      { label: '½ Kelly', frac: half },
      { label: '¼ Kelly', frac: quarter },
      { label: '⅛ Kelly', frac: kelly / 8 },
    ];

    const tbody = document.querySelector('[data-output="risk-table"]') as HTMLElement;
    tbody.innerHTML = '';
    for (const row of fractions) {
      const betSize = row.frac * bankroll;
      const contracts = Math.floor(betSize / cost);
      const g = p * Math.log(1 + row.frac * b) + q * Math.log(1 - row.frac);
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2 text-gray-900 dark:text-gray-100 font-medium">${row.label}</td>
        <td class="py-2 text-gray-900 dark:text-gray-100">$${betSize.toFixed(2)}</td>
        <td class="py-2 text-gray-900 dark:text-gray-100">${contracts}</td>
        <td class="py-2 text-gray-900 dark:text-gray-100">${(g * 100).toFixed(3)}%</td>
      `;
      tbody.appendChild(tr);
    }
  }

  function setText(key: string, value: string) {
    const el = document.querySelector(`[data-output="${key}"]`);
    if (el) el.textContent = value;
  }

  function setColor(key: string, colorClass: string) {
    const el = document.querySelector(`[data-output="${key}"]`);
    if (el) {
      el.classList.remove('text-green-600', 'text-red-600');
      el.classList.add(colorClass);
    }
  }

  calculate();
</script>
