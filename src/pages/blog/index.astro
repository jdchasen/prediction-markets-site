---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const allPosts = (await getCollection('blog'))
  .filter((post) => post.data.pubDate.valueOf() <= now.valueOf())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog - All Articles"
  description="Browse all prediction market articles: platform reviews, trading strategies, beginner guides, and expert analysis."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="mb-2 text-3xl font-bold text-gray-900">All Articles</h1>
    <p class="mb-10 text-gray-600">
      Prediction market guides, strategies, and platform reviews.
    </p>

    {allPosts.length === 0 ? (
      <p class="text-gray-500">No articles yet. Check back soon!</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {allPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
