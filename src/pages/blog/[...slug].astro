---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CTABanner from '../../components/CTABanner.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SocialShare from '../../components/SocialShare.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog')).filter(
    (post) => post.data.pubDate.valueOf() <= now.valueOf()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);

const now = new Date();
const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter((p) => p.id !== post.id && p.data.pubDate.valueOf() <= now.valueOf());

// Score related posts: category match + tag overlap
const postTags = new Set(post.data.tags.map((t: string) => t.toLowerCase()));
const scoredPosts = publishedPosts.map((p) => {
  let score = 0;
  if (p.data.category === post.data.category) score += 3;
  const tagOverlap = p.data.tags.filter((t: string) => postTags.has(t.toLowerCase())).length;
  score += tagOverlap;
  return { post: p, score };
});
const relatedPosts = scoredPosts
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ post }) => post);

// Related markets — match by tag overlap (same approach odds pages use for blog linking)
const allMarkets = await getCollection('markets');
const relatedMarkets = allMarkets
  .filter((m) => m.data.status === 'active')
  .map((m) => {
    const overlap = m.data.tags.filter((t: string) => postTags.has(t.toLowerCase())).length;
    return { market: m, overlap };
  })
  .filter(({ overlap }) => overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3)
  .map(({ market }) => market);

const categoryColors: Record<string, string> = {
  politics: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
  economics: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300',
  crypto: 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300',
  finance: 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300',
  sports: 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300',
  tech: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300',
  entertainment: 'bg-pink-100 text-pink-800 dark:bg-pink-900/50 dark:text-pink-300',
  science: 'bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300',
};

function formatVolume(vol: number | undefined, platform: string): string {
  if (!vol) return '';
  if (platform === 'polymarket') {
    if (vol >= 1_000_000) return `$${(vol / 1_000_000).toFixed(1)}M`;
    if (vol >= 1_000) return `$${(vol / 1_000).toFixed(0)}K`;
    return `$${vol.toLocaleString()}`;
  }
  if (vol >= 1_000_000) return `${(vol / 1_000_000).toFixed(1)}M`;
  if (vol >= 1_000) return `${(vol / 1_000).toFixed(0)}K`;
  return vol.toLocaleString();
}

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const affiliatePlatform = post.data.affiliate as 'kalshi' | 'polymarket' | 'generic' | undefined;
const postUrl = new URL(`/blog/${post.id}`, Astro.site).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://masterpredictionmarkets.com",
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://masterpredictionmarkets.com/blog",
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
    },
  ],
};

const faqSchema = post.data.faqs.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faqs.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
} : null;

const howToSchema = post.data.howToSteps?.length ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": post.data.title,
  "description": post.data.description,
  "step": post.data.howToSteps.map((step: { name: string; text: string }, i: number) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text,
  })),
} : null;

const reviewSchema = post.data.review ? {
  "@context": "https://schema.org",
  "@type": "Review",
  "name": post.data.title,
  "reviewBody": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "itemReviewed": {
    "@type": post.data.review.itemType || "Product",
    "name": post.data.review.itemName,
    "image": new URL('/og-default.png', Astro.site).href,
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": post.data.review.rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "author": {
    "@type": "Organization",
    "name": "Master Prediction Markets",
    "url": "https://masterpredictionmarkets.com",
  },
  "publisher": {
    "@type": "Organization",
    "name": "Master Prediction Markets",
  },
} : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article={true}
  pubDate={post.data.pubDate.toISOString()}
  updatedDate={post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString()}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {reviewSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
    )}
    {howToSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-4 flex items-center gap-3">
        <a
          href={`/category/${post.data.category}`}
          class="rounded-full bg-brand-100 dark:bg-brand-900/50 px-3 py-1 text-xs font-medium capitalize text-brand-800 dark:text-brand-300 hover:bg-brand-200 dark:hover:bg-brand-900"
        >
          {post.data.category}
        </a>
        <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-500 dark:text-gray-400">
          {formattedDate}
        </time>
      </div>
      <h1 class="text-3xl font-bold leading-tight text-gray-900 dark:text-white md:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{post.data.description}</p>
    </header>

    <TableOfContents headings={headings} />

    <div class="prose prose-gray dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>

    <style>
      .prose :global(table) {
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
    </style>

    <NewsletterForm variant="banner" />

    <CTABanner platform={affiliatePlatform || 'generic'} />

    {post.data.tags.length > 0 && (
      <div class="mt-8 border-t border-gray-200 dark:border-gray-700 pt-6">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1 text-xs text-gray-600 dark:text-gray-400">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <SocialShare title={post.data.title} url={postUrl} />
  </article>

  {relatedPosts.length > 0 && (
    <section class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 py-12">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-white">Related Articles</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedPosts.map((related) => (
            <ArticleCard
              title={related.data.title}
              description={related.data.description}
              pubDate={related.data.pubDate}
              category={related.data.category}
              slug={related.id}
              heroImage={related.data.heroImage}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedMarkets.length > 0 && (
    <section class="border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 py-12">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-white">Related Markets</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {relatedMarkets.map((market) => {
            const catColor = categoryColors[market.data.category] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
            return (
              <a
                href={`/odds/${market.id}`}
                class="group rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 transition-all hover:shadow-md hover:-translate-y-0.5"
              >
                <div class="mb-3 flex items-center gap-2">
                  <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium capitalize', catColor]}>
                    {market.data.category}
                  </span>
                </div>
                <h3 class="mb-3 text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 line-clamp-2">
                  {market.data.marketQuestion}
                </h3>
                <div class="space-y-1.5">
                  {market.data.kalshiYes !== undefined && (
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Kalshi</span>
                      <div class="flex items-center gap-2">
                        <span class="font-medium text-green-700 dark:text-green-400">{market.data.kalshiYes}% Yes</span>
                        <span class="text-gray-400 dark:text-gray-500">{formatVolume(market.data.kalshiVolume, 'kalshi')} vol</span>
                      </div>
                    </div>
                  )}
                  {market.data.polymarketYes !== undefined && (
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Polymarket</span>
                      <div class="flex items-center gap-2">
                        <span class="font-medium text-blue-700 dark:text-blue-400">{market.data.polymarketYes}% Yes</span>
                        <span class="text-gray-400 dark:text-gray-500">{formatVolume(market.data.polymarketVolume, 'polymarket')} vol</span>
                      </div>
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
