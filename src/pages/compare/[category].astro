    : 'border-gray-400 bg-gray-50 dark:border-gray-600 dark:bg-gray-900/20';

const verdictLabel = data.verdictWinner === 'kalshi'
  ? 'Kalshi'
  : data.verdictWinner === 'polymarket'
    ? 'Polymarket'
    : 'Tie';

// Build FAQ schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
