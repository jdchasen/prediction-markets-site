          {verdictLabel} Wins
        </span>
      </div>
      <p class="text-gray-800 dark:text-gray-200">{data.verdict}</p>
    </div>

    <!-- Feature Comparison Table -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">{catLabel} Platform Comparison</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800">
              <th class="py-3 px-4 text-left font-semibold text-gray-900 dark:text-white">Feature</th>
              <th class="py-3 px-4 text-left font-semibold text-green-700 dark:text-green-400">Kalshi</th>
              <th class="py-3 px-4 text-left font-semibold text-blue-700 dark:text-blue-400">Polymarket</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">Regulation</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">CFTC-regulated</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Unregulated</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">Deposit</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">USD (bank, card)</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">USDC (crypto)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">Trading Fees</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">No fees</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">No fees</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">US Access</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Full access</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Limited</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">{catLabel} Markets</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">{data.verdictWinner === 'kalshi' ? 'Extensive' : 'Moderate'}</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">{data.verdictWinner === 'polymarket' ? 'Extensive' : 'Moderate'}</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-gray-600 dark:text-gray-400">{catLabel} Liquidity</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">{data.verdictWinner === 'kalshi' ? 'Strong' : 'Moderate'}</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">{data.verdictWinner === 'polymarket' ? 'Strong' : 'Moderate'}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Strengths Comparison -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Platform Strengths for {catLabel}</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-lg border-2 border-green-300 dark:border-green-700 p-5">
          <h3 class="mb-3 text-lg font-bold text-green-700 dark:text-green-400">Kalshi Strengths</h3>
          <ul class="space-y-2">
            {data.kalshiStrengths.map((s) => (
              <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                <span class="mt-1 text-green-500">&#x2713;</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border-2 border-blue-300 dark:border-blue-700 p-5">
          <h3 class="mb-3 text-lg font-bold text-blue-700 dark:text-blue-400">Polymarket Strengths</h3>
          <ul class="space-y-2">
            {data.polymarketStrengths.map((s) => (
              <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                <span class="mt-1 text-blue-500">&#x2713;</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Category Analysis -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">{catLabel} Market Analysis</h2>
      <div class="prose prose-gray dark:prose-invert max-w-none">
        {data.analysis.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Our Recommendation -->
    <section class="mb-10">
      <div class="rounded-lg bg-brand-50 dark:bg-brand-900/20 border border-brand-200 dark:border-brand-800 p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Our Recommendation</h2>
        <p class="text-gray-700 dark:text-gray-300">{data.recommendation}</p>
      </div>
    </section>

    <!-- Active Markets in Category -->
    {categoryMarkets.length > 0 && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Active {catLabel} Markets</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {categoryMarkets.map((market) => (
            <a
              href={`/odds/${market.id}`}
              class="group rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              <h3 class="mb-2 text-sm font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 line-clamp-2">
                {market.data.marketQuestion}
              </h3>
              <div class="space-y-1">
                {market.data.kalshiYes !== undefined && (
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-gray-500 dark:text-gray-400">Kalshi</span>
                    <span class="font-medium text-green-700 dark:text-green-400">{market.data.kalshiYes}% Yes</span>
                  </div>
                )}
                {market.data.polymarketYes !== undefined && (
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-gray-500 dark:text-gray-400">Polymarket</span>
                    <span class="font-medium text-blue-700 dark:text-blue-400">{market.data.polymarketYes}% Yes</span>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
        <p class="mt-3 text-center">
          <a href={`/odds/${category}`} class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:underline">
            View all {catLabel.toLowerCase()} markets &rarr;
          </a>
        </p>
      </section>
    )}

    <!-- Dual CTAs -->
    <section class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <a
        href={KALSHI_REFERRAL}
        target="_blank"
        rel="noopener sponsored"
        class="flex flex-col items-center rounded-lg border-2 border-green-300 dark:border-green-700 bg-green-50 dark:bg-green-900/20 p-6 text-center transition-all hover:shadow-md hover:-translate-y-0.5"
      >
        <span class="mb-2 text-lg font-bold text-green-700 dark:text-green-400">Try Kalshi</span>
        <span class="mb-3 text-sm text-gray-600 dark:text-gray-400">CFTC-regulated, USD deposits</span>
        <span class="rounded-md bg-green-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-green-700 transition-colors">
          Sign Up Free
        </span>
      </a>
      <a
        href={POLYMARKET_REFERRAL}
        target="_blank"
        rel="noopener sponsored"
        class="flex flex-col items-center rounded-lg border-2 border-blue-300 dark:border-blue-700 bg-blue-50 dark:bg-blue-900/20 p-6 text-center transition-all hover:shadow-md hover:-translate-y-0.5"
      >
        <span class="mb-2 text-lg font-bold text-blue-700 dark:text-blue-400">Try Polymarket</span>
        <span class="mb-3 text-sm text-gray-600 dark:text-gray-400">Deep liquidity, USDC trading</span>
        <span class="rounded-md bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors">
          Start Trading
        </span>
      </a>
    </section>

    <!-- FAQ Section -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {data.faqs.map((faq) => (
          <details class="group rounded-lg border border-gray-200 dark:border-gray-700">
            <summary class="flex cursor-pointer items-center justify-between p-4 text-gray-900 dark:text-white font-medium">
              {faq.question}
              <svg class="h-5 w-5 text-gray-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-sm text-gray-600 dark:text-gray-400">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- More Comparisons -->
    <section>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">More Platform Comparisons</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {otherCategories.map((cat) => (
          <a
            href={`/compare/${cat}`}
            class="rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-center text-sm font-medium text-gray-700 dark:text-gray-300 transition-all hover:border-brand-400 hover:text-brand-600 dark:hover:text-brand-400 hover:shadow-sm"
          >
            {CATEGORY_DATA[cat].title}
          </a>
        ))}
      </div>
      <p class="mt-3 text-center">
        <a href="/compare" class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:underline">
          View all comparisons &rarr;
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
