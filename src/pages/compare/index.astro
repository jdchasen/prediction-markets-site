---
import BaseLayout from '../../layouts/BaseLayout.astro';

const CATEGORIES = [
  {
    slug: 'crypto',
    label: 'Crypto',
    icon: '&#x20BF;',
    description: 'Bitcoin, Ethereum, and token price markets',
    color: 'border-purple-400 dark:border-purple-600',
    bg: 'bg-purple-50 dark:bg-purple-900/20',
  },
  {
    slug: 'politics',
    label: 'Politics',
    icon: '&#x1F3DB;',
    description: 'Elections, policy, and geopolitics',
    color: 'border-red-400 dark:border-red-600',
    bg: 'bg-red-50 dark:bg-red-900/20',
  },
  {
    slug: 'economics',
    label: 'Economics',
    icon: '&#x1F4C8;',
    description: 'GDP, inflation, interest rates, and jobs',
    color: 'border-yellow-400 dark:border-yellow-600',
    bg: 'bg-yellow-50 dark:bg-yellow-900/20',
  },
  {
    slug: 'finance',
    label: 'Finance',
    icon: '&#x1F4B5;',
    description: 'Stocks, IPOs, and market cap predictions',
    color: 'border-green-400 dark:border-green-600',
    bg: 'bg-green-50 dark:bg-green-900/20',
  },
  {
    slug: 'sports',
    label: 'Sports',
    icon: '&#x26BD;',
    description: 'NFL, NBA, MLB, NHL, and major events',
    color: 'border-orange-400 dark:border-orange-600',
    bg: 'bg-orange-50 dark:bg-orange-900/20',
  },
  {
    slug: 'tech',
    label: 'Tech',
    icon: '&#x1F4BB;',
    description: 'AI, startups, and technology milestones',
    color: 'border-blue-400 dark:border-blue-600',
    bg: 'bg-blue-50 dark:bg-blue-900/20',
  },
  {
    slug: 'entertainment',
    label: 'Entertainment',
    icon: '&#x1F3AC;',
    description: 'Oscars, Emmys, Grammys, and pop culture',
    color: 'border-pink-400 dark:border-pink-600',
    bg: 'bg-pink-50 dark:bg-pink-900/20',
  },
  {
    slug: 'science',
    label: 'Science',
    icon: '&#x1F52C;',
    description: 'Weather, climate, and scientific milestones',
    color: 'border-teal-400 dark:border-teal-600',
    bg: 'bg-teal-50 dark:bg-teal-900/20',
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://masterpredictionmarkets.com" },
    { "@type": "ListItem", "position": 2, "name": "Compare Platforms" },
  ],
};
---

<BaseLayout
  title="Kalshi vs Polymarket: Platform Comparison by Category"
  description="Compare Kalshi and Polymarket across every market category — crypto, politics, economics, sports, and more. Find the best prediction market platform for your trading style."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <nav class="mx-auto max-w-6xl px-4 pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gray-900 dark:text-white font-medium">Compare Platforms</li>
    </ol>
  </nav>

  <section class="bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-12">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
        Kalshi vs Polymarket: <span class="text-brand-600 dark:text-brand-400">Compare by Category</span>
      </h1>
      <p class="mx-auto mb-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        Not sure which prediction market platform to use? Compare Kalshi and Polymarket head-to-head across every market category to find the best fit for your trading strategy.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {CATEGORIES.map((cat) => (
          <a
            href={`/compare/${cat.slug}`}
            class:list={[
              'group rounded-lg border-2 p-6 transition-all hover:shadow-lg hover:-translate-y-1',
              cat.color,
              cat.bg,
            ]}
          >
            <div class="mb-3 text-3xl" set:html={cat.icon} />
            <h2 class="mb-2 text-lg font-bold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">
              {cat.label}
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              {cat.description}
            </p>
            <span class="mt-3 inline-block text-sm font-medium text-brand-600 dark:text-brand-400">
              Compare platforms &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">Quick Platform Overview</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="py-3 px-4 font-semibold text-gray-900 dark:text-white">Feature</th>
              <th class="py-3 px-4 font-semibold text-green-700 dark:text-green-400">Kalshi</th>
              <th class="py-3 px-4 font-semibold text-blue-700 dark:text-blue-400">Polymarket</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">Regulation</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">CFTC-regulated (US)</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Unregulated (offshore)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">Deposit Method</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">USD (bank, card)</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">USDC (crypto)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">Fees</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">No trading fees</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">No trading fees</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">US Residents</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Yes</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Limited access</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">Liquidity</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Moderate</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">High (crypto/politics)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-gray-600 dark:text-gray-400">Market Range</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Economics, weather, finance</td>
              <td class="py-3 px-4 text-gray-900 dark:text-gray-100">Crypto, politics, culture</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
