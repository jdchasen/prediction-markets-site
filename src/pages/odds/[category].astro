---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getCollection } from 'astro:content';

const CATEGORIES = ['politics', 'crypto', 'sports', 'finance', 'entertainment', 'economics', 'tech', 'science'] as const;

const CATEGORY_META: Record<string, { title: string; description: string }> = {
  politics: {
    title: 'Politics Prediction Market Odds',
    description: 'Live politics prediction market odds — elections, policy, and geopolitics. Compare prices across Kalshi and Polymarket.',
  },
  crypto: {
    title: 'Crypto Prediction Market Odds',
    description: 'Live crypto prediction market odds — Bitcoin, Ethereum, and token prices. Compare odds across Kalshi and Polymarket.',
  },
  sports: {
    title: 'Sports Prediction Market Odds',
    description: 'Live sports prediction market odds — NFL, NBA, MLB, NHL, and more. Compare prices across Kalshi and Polymarket.',
  },
  finance: {
    title: 'Finance Prediction Market Odds',
    description: 'Live finance prediction market odds — stocks, IPOs, and market cap. Compare prices across Kalshi and Polymarket.',
  },
  entertainment: {
    title: 'Entertainment Prediction Market Odds',
    description: 'Live entertainment prediction market odds — Oscars, Emmys, and pop culture. Compare prices across Kalshi and Polymarket.',
  },
  economics: {
    title: 'Economics Prediction Market Odds',
    description: 'Live economics prediction market odds — GDP, inflation, interest rates, and jobs. Compare prices across Kalshi and Polymarket.',
  },
  tech: {
    title: 'Tech Prediction Market Odds',
    description: 'Live tech prediction market odds — AI, startups, and technology events. Compare prices across Kalshi and Polymarket.',
  },
  science: {
    title: 'Science Prediction Market Odds',
    description: 'Live science prediction market odds — weather, climate, and scientific milestones. Compare prices across Kalshi and Polymarket.',
  },
};

export function getStaticPaths() {
  return (['politics', 'crypto', 'sports', 'finance', 'entertainment', 'economics', 'tech', 'science'] as const).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const meta = CATEGORY_META[category] || { title: category, description: '' };

const allMarkets = await getCollection('markets');
const categoryMarkets = allMarkets
  .filter((m) => m.data.category === category && m.data.status === 'active')
  .sort((a, b) => {
    const aVol = (a.data.kalshiVolume || 0) + (a.data.polymarketVolume || 0);
    const bVol = (b.data.kalshiVolume || 0) + (b.data.polymarketVolume || 0);
    return bVol - aVol;
  });

const categoryColors: Record<string, string> = {
  politics: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
  economics: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300',
  crypto: 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300',
  finance: 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300',
  sports: 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300',
  tech: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300',
  entertainment: 'bg-pink-100 text-pink-800 dark:bg-pink-900/50 dark:text-pink-300',
  science: 'bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300',
};

function formatVolume(vol: number | undefined, platform: string): string {
  if (!vol) return '';
  if (platform === 'polymarket') {
    if (vol >= 1_000_000) return `$${(vol / 1_000_000).toFixed(1)}M`;
    if (vol >= 1_000) return `$${(vol / 1_000).toFixed(0)}K`;
    return `$${vol.toLocaleString()}`;
  }
  if (vol >= 1_000_000) return `${(vol / 1_000_000).toFixed(1)}M`;
  if (vol >= 1_000) return `${(vol / 1_000).toFixed(0)}K`;
  return vol.toLocaleString();
}

const catLabel = category.charAt(0).toUpperCase() + category.slice(1);

// Schema.org ItemList
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": meta.title,
  "numberOfItems": categoryMarkets.length,
  "itemListElement": categoryMarkets.slice(0, 50).map((m, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": m.data.marketQuestion,
    "url": `https://predictionmarkets.com/odds/${m.id}`,
  })),
};
---

<BaseLayout title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-6xl px-4 pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/odds" class="hover:text-brand-600 dark:hover:text-brand-400">Odds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gray-900 dark:text-white font-medium">{catLabel}</li>
    </ol>
  </nav>

  <section class="bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-12">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
        {catLabel} Prediction Market <span class="text-brand-600 dark:text-brand-400">Odds</span>
      </h1>
      <p class="mx-auto mb-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        {meta.description}
      </p>
    </div>
  </section>

  <section class="py-8">
    <div class="mx-auto max-w-6xl px-4">
      <!-- Category navigation -->
      <div class="mb-8 flex flex-wrap gap-2">
        <a
          href="/odds"
          class="rounded-full border border-gray-300 dark:border-gray-600 px-4 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-400 transition-colors hover:border-brand-600 hover:text-brand-600 dark:hover:border-brand-400 dark:hover:text-brand-400"
        >
          All
        </a>
        {CATEGORIES.map((cat) => (
          <a
            href={`/odds/${cat}`}
            class:list={[
              'rounded-full border px-4 py-1.5 text-sm font-medium transition-colors',
              cat === category
                ? 'border-brand-600 bg-brand-600 text-white'
                : 'border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 hover:border-brand-600 hover:text-brand-600 dark:hover:border-brand-400 dark:hover:text-brand-400',
            ]}
          >
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </a>
        ))}
      </div>

      <!-- Market cards grid -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {categoryMarkets.map((market) => {
          const catColor = categoryColors[market.data.category] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
          const isSettled = market.data.status === 'settled';

          return (
            <a
              href={`/odds/${market.id}`}
              class="group rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              <div class="mb-3 flex items-center gap-2">
                <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium capitalize', catColor]}>
                  {market.data.category}
                </span>
                <span class:list={[
                  'rounded-full px-2.5 py-0.5 text-xs font-medium',
                  isSettled ? 'bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-400' : 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300',
                ]}>
                  {isSettled ? 'Settled' : 'Active'}
                </span>
              </div>

              <h2 class="mb-3 text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 line-clamp-2">
                {market.data.marketQuestion}
              </h2>

              <div class="space-y-1.5">
                {market.data.kalshiYes !== undefined && (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 dark:text-gray-400">Kalshi</span>
                    <div class="flex items-center gap-3">
                      <span class="font-medium text-green-700 dark:text-green-400">{market.data.kalshiYes}% Yes</span>
                      <span class="text-gray-400 dark:text-gray-500">{formatVolume(market.data.kalshiVolume, 'kalshi')} vol</span>
                    </div>
                  </div>
                )}
                {market.data.polymarketYes !== undefined && (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 dark:text-gray-400">Polymarket</span>
                    <div class="flex items-center gap-3">
                      <span class="font-medium text-blue-700 dark:text-blue-400">{market.data.polymarketYes}% Yes</span>
                      <span class="text-gray-400 dark:text-gray-500">{formatVolume(market.data.polymarketVolume, 'polymarket')} vol</span>
                    </div>
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>

      {categoryMarkets.length === 0 && (
        <div class="py-16 text-center">
          <p class="text-lg text-gray-500 dark:text-gray-400">No {catLabel.toLowerCase()} markets available right now. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <section class="py-8">
    <div class="mx-auto max-w-3xl px-4">
      <NewsletterForm variant="banner" />
    </div>
  </section>
</BaseLayout>
