---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTABanner from '../components/CTABanner.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const allPosts = (await getCollection('blog'))
  .filter((post) => post.data.pubDate.valueOf() <= now.valueOf())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = allPosts.slice(0, 6);

const allMarkets = await getCollection('markets');
const trendingMarkets = allMarkets
  .filter((m) => m.data.status === 'active')
  .sort((a, b) => {
    const aVol = (a.data.kalshiVolume || 0) + (a.data.polymarketVolume || 0);
    const bVol = (b.data.kalshiVolume || 0) + (b.data.polymarketVolume || 0);
    return bVol - aVol;
  })
  .slice(0, 6);

const categories = [
  {
    name: 'Kalshi',
    slug: 'kalshi',
    description: 'Guides and strategies for trading on Kalshi',
    color: 'bg-green-50 border-green-200 text-green-900 dark:bg-green-900/30 dark:border-green-800 dark:text-green-200',
    icon: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>',
  },
  {
    name: 'Polymarket',
    slug: 'polymarket',
    description: 'Everything about crypto prediction markets',
    color: 'bg-blue-50 border-blue-200 text-blue-900 dark:bg-blue-900/30 dark:border-blue-800 dark:text-blue-200',
    icon: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
  },
  {
    name: 'Strategies',
    slug: 'strategies',
    description: 'Trading strategies and edge-finding techniques',
    color: 'bg-purple-50 border-purple-200 text-purple-900 dark:bg-purple-900/30 dark:border-purple-800 dark:text-purple-200',
    icon: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>',
  },
  {
    name: 'Beginners',
    slug: 'beginners',
    description: 'Start here if you are new to prediction markets',
    color: 'bg-orange-50 border-orange-200 text-orange-900 dark:bg-orange-900/30 dark:border-orange-800 dark:text-orange-200',
    icon: '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>',
  },
];
---

<BaseLayout
  title="Master Prediction Markets - Expert Guides & Strategies"
  description="Expert analysis, strategies, and guides for prediction market traders. Learn to trade event contracts on Kalshi, Polymarket, and more."
>
  <section class="relative bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-16 overflow-hidden">
    <!-- Dot grid pattern -->
    <div class="absolute inset-0 opacity-40 dark:opacity-20" style="background-image: radial-gradient(circle, rgb(156 163 175 / 0.4) 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative mx-auto max-w-6xl px-4 text-center">
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl">
        Master <span class="text-brand-600 dark:text-brand-400">Prediction Markets</span>
      </h1>
      <p class="mx-auto mb-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        Expert strategies, platform reviews, and actionable guides from real traders.
        Learn to find edge in event contracts on Kalshi, Polymarket, and beyond.
      </p>

      <!-- Trust signals -->
      <div class="mb-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-gray-500">
        <span>25+ Expert Guides</span>
        <span class="hidden sm:inline">&middot;</span>
        <span>4 Free Tools</span>
        <span class="hidden sm:inline">&middot;</span>
        <span>Daily Market Pulse</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/blog"
          class="rounded-lg bg-brand-600 px-8 py-3.5 text-base font-medium text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
        >
          Read Articles
        </a>
        <a
          href="/about"
          class="rounded-lg border border-brand-300 dark:border-brand-500 bg-white dark:bg-transparent px-8 py-3.5 text-base font-medium text-brand-700 dark:text-brand-400 transition-colors hover:bg-brand-50 dark:hover:bg-brand-950"
        >
          About Us
        </a>
      </div>
      <NewsletterForm variant="inline" />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-white">Browse by Category</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class:list={['rounded-lg border p-6 transition-all hover:shadow-md hover:-translate-y-0.5', cat.color]}
          >
            <div class="mb-2 opacity-70">
              <Fragment set:html={cat.icon} />
            </div>
            <h3 class="mb-1 font-semibold">{cat.name}</h3>
            <p class="text-sm opacity-80">{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Latest Articles</h2>
        <a href="/blog" class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300">
          View all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    </div>
  </section>

  {trendingMarkets.length > 0 && (
    <section class="border-t border-gray-100 dark:border-gray-800 py-12">
      <div class="mx-auto max-w-6xl px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Trending Market Odds</h2>
          <a href="/odds" class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300">
            View all &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {trendingMarkets.map((market) => {
            const primaryYes = market.data.kalshiYes ?? market.data.polymarketYes ?? 0;
            return (
              <a
                href={`/odds/${market.id}`}
                class="group rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 transition-all hover:shadow-md hover:-translate-y-0.5"
              >
                <h3 class="mb-3 text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 line-clamp-2">
                  {market.data.marketQuestion}
                </h3>
                <div class="space-y-1.5">
                  {market.data.kalshiYes !== undefined && (
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Kalshi</span>
                      <span class="font-medium text-green-700 dark:text-green-400">{market.data.kalshiYes}% Yes</span>
                    </div>
                  )}
                  {market.data.polymarketYes !== undefined && (
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Polymarket</span>
                      <span class="font-medium text-blue-700 dark:text-blue-400">{market.data.polymarketYes}% Yes</span>
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 space-y-6">
      <CTABanner platform="kalshi" />
      <CTABanner platform="polymarket" />
    </div>
  </section>
</BaseLayout>
