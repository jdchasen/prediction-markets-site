---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/odds', label: 'Odds' },
  { href: '/blog', label: 'Blog' },
  { href: '/category/kalshi', label: 'Kalshi' },
  { href: '/category/polymarket', label: 'Polymarket' },
  { href: '/category/strategies', label: 'Strategies' },
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-gray-200 bg-white">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold text-gray-900">
      <span class="text-brand-600">Master</span>PredictionMarkets
    </a>

    <button
      id="mobile-menu-btn"
      class="md:hidden rounded-md p-2 text-gray-600 hover:bg-gray-100"
      aria-label="Toggle menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-600',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-brand-600'
                : 'text-gray-600',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-gray-200 md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-gray-100',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-brand-600 bg-brand-50'
                : 'text-gray-600',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
