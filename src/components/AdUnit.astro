---
import { ADSENSE_ENABLED, ADSENSE_PUBLISHER_ID, AD_SLOTS } from '../config/ads';

interface Props {
  slot: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  className?: string;
}

const { slot, format = 'auto', className = '' } = Astro.props;
const slotId = AD_SLOTS[slot];
---

{ADSENSE_ENABLED && slotId && (
  <div class:list={['ad-unit my-6 text-center', className]}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_PUBLISHER_ID}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
