          <li><a href="/category/strategies" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">Trading Strategies</a></li>
          <li><a href="/compare" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">Compare Platforms</a></li>
          <li><a href="/tools" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">Trading Tools</a></li>
          <li><a href="/blog" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">All Articles</a></li>
