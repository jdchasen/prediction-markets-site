---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div>
        <a href="/" class="text-lg font-bold text-gray-900 dark:text-white">
          <span class="text-brand-600 dark:text-brand-400">Master</span>PredictionMarkets
        </a>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          Expert analysis, strategies, and guides for prediction market traders. Built by real traders, backed by real data.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-gray-200">Platforms</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/category/kalshi" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">Kalshi</a></li>
          <li><a href="/category/polymarket" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">Polymarket</a></li>
