          <li><a href="/rss.xml" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">RSS Feed</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-200 dark:border-gray-800 pt-6">
      <p class="text-center text-xs text-gray-500 dark:text-gray-500">
        &copy; {currentYear} Master Prediction Markets. All rights reserved.
        Trading involves risk. Past performance does not guarantee future results.
      </p>
