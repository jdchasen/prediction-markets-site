---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div>
        <a href="/" class="text-lg font-bold text-gray-900">
          <span class="text-brand-600">Master</span>PredictionMarkets
        </a>
        <p class="mt-3 text-sm text-gray-600">
          Expert analysis, strategies, and guides for prediction market traders. Built by real traders, backed by real data.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Platforms</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/category/kalshi" class="text-sm text-gray-600 hover:text-brand-600">Kalshi</a></li>
          <li><a href="/category/polymarket" class="text-sm text-gray-600 hover:text-brand-600">Polymarket</a></li>
          <li><a href="/category/beginners" class="text-sm text-gray-600 hover:text-brand-600">Beginner Guides</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Resources</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/category/strategies" class="text-sm text-gray-600 hover:text-brand-600">Trading Strategies</a></li>
          <li><a href="/blog" class="text-sm text-gray-600 hover:text-brand-600">All Articles</a></li>
          <li><a href="/about" class="text-sm text-gray-600 hover:text-brand-600">About</a></li>
          <li><a href="/rss.xml" class="text-sm text-gray-600 hover:text-brand-600">RSS Feed</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-200 pt-6">
      <p class="text-center text-xs text-gray-500">
        &copy; {currentYear} Master Prediction Markets. All rights reserved.
        Trading involves risk. Past performance does not guarantee future results.
      </p>
    </div>
  </div>
</footer>
