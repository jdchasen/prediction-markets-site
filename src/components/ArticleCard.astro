---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  slug: string;
  heroImage?: string;
}

const { title, description, pubDate, category, slug, heroImage } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  kalshi: 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300',
  polymarket: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300',
  strategies: 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300',
  beginners: 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300',
};

const accentColors: Record<string, string> = {
  kalshi: 'border-t-green-500 dark:border-t-green-400',
  polymarket: 'border-t-blue-500 dark:border-t-blue-400',
  strategies: 'border-t-purple-500 dark:border-t-purple-400',
  beginners: 'border-t-orange-500 dark:border-t-orange-400',
};

const colorClass = categoryColors[category] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
const accentClass = accentColors[category] || 'border-t-gray-400';

const wordCount = description.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 40) + 4);
---

<article class:list={['group rounded-lg border border-gray-200 dark:border-gray-700 border-t-4 bg-white dark:bg-gray-800 transition-all hover:shadow-md hover:-translate-y-0.5', accentClass]}>
  {heroImage && (
    <a href={`/blog/${slug}`}>
      <img
        src={heroImage}
        alt={title}
        class="h-40 sm:h-48 w-full rounded-t-lg object-cover"
        loading="lazy"
      />
    </a>
  )}
  <div class="p-5">
    <div class="mb-3 flex items-center gap-3">
      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium capitalize', colorClass]}>
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-xs text-gray-500 dark:text-gray-500">
        {formattedDate} &middot; {readingTime} min read
      </time>
    </div>

    <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400">
      <a href={`/blog/${slug}`} class="hover:underline">
        {title}
      </a>
    </h2>

    <p class="mb-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400 line-clamp-2">
      {description}
    </p>

    <a
      href={`/blog/${slug}`}
      class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300"
    >
      Read more &rarr;
    </a>
  </div>
</article>
