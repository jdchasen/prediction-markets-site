---
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  newsArticle?: boolean;
  pubDate?: string;
  updatedDate?: string;
}

const SITE_NAME = "Master Prediction Markets";
const SITE_URL = "https://masterpredictionmarkets.com";
const DEFAULT_IMAGE = "/og-default.png";

const { title, description, image, article = false, newsArticle = false, pubDate, updatedDate } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || DEFAULT_IMAGE, Astro.site).href;
const suffix = ` | ${SITE_NAME}`;
const fullTitle = (title.length + suffix.length) <= 60 ? `${title}${suffix}` : title;

const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE_NAME,
  "url": SITE_URL,
  "logo": `${SITE_URL}/og-default.png`,
  "description": "Expert guides, tools, and analysis for prediction market traders on Kalshi and Polymarket.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${SITE_URL}/blog?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<meta charset="utf-8" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#1e40af" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
<meta name="google-site-verification" content="mct5EdH10wGiQ_DP0aTK5_tEzAdFmRTvyZJG-UB9Zis" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE_NAME} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Article-specific meta -->
{article && pubDate && (
  <meta property="article:published_time" content={pubDate} />
)}
{article && updatedDate && (
  <meta property="article:modified_time" content={updatedDate} />
)}

<!-- Organization + WebSite schema (homepage only to avoid duplication) -->
{isHomepage && (
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
)}
{isHomepage && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}

<!-- Schema.org Article JSON-LD -->
{article && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": newsArticle ? "NewsArticle" : "Article",
    "headline": title,
    "description": description,
    "image": ogImage,
    "datePublished": pubDate || undefined,
    "dateModified": updatedDate || pubDate || undefined,
    "url": canonicalURL.href,
    "inLanguage": "en-US",
    "author": {
      "@type": "Organization",
      "name": SITE_NAME,
      "url": SITE_URL,
    },
    "publisher": {
      "@type": "Organization",
      "name": SITE_NAME,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE_URL}/og-default.png`,
      },
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.href,
    },
  })} />
)}
