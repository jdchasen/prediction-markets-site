---
interface Props {
  platform?: 'kalshi' | 'polymarket' | 'generic';
}

const { platform = 'generic' } = Astro.props;

const ctas: Record<string, { heading: string; text: string; buttonText: string; href: string; color: string }> = {
  kalshi: {
    heading: 'Start Trading on Kalshi',
    text: 'Trade real-money event contracts on weather, economics, politics, and more. CFTC-regulated and available to US residents.',
    buttonText: 'Sign Up for Kalshi',
    href: 'https://kalshi.com/sign-up/?referral=f2e21ad4-75b7-4ffb-bfcc-f2fb36e07b21&m=true&utm_source=masterpredictionmarkets&utm_medium=cta-banner&utm_campaign=signup',
    color: 'bg-green-600 hover:bg-green-700',
  },
  polymarket: {
    heading: 'Try Polymarket',
    text: 'The largest prediction market by volume. Trade on crypto-based event contracts with deep liquidity.',
    buttonText: 'Explore Polymarket',
    href: 'https://polymarket.us/1762?utm_source=masterpredictionmarkets&utm_medium=cta-banner&utm_campaign=signup',
    color: 'bg-blue-600 hover:bg-blue-700',
  },
  generic: {
    heading: 'Ready to Start Trading Prediction Markets?',
    text: 'Prediction markets let you trade on real-world events. Start with a regulated platform and learn the fundamentals before risking real capital.',
    buttonText: 'Compare Platforms',
    href: '/platforms',
    color: 'bg-brand-600 hover:bg-brand-700',
  },
};

const accentBorder: Record<string, string> = {
  kalshi: 'border-l-green-500',
  polymarket: 'border-l-blue-500',
  generic: 'border-l-brand-500',
};

const cta = ctas[platform];
const accent = accentBorder[platform];
---

<aside class:list={['my-8 rounded-lg border-l-4 bg-gray-50 dark:bg-gray-800 p-6', accent]}>
  <h3 class="mb-2 text-xl font-semibold text-gray-900 dark:text-gray-100">{cta.heading}</h3>
  <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">{cta.text}</p>
  <a
    href={cta.href}
    target={platform !== 'generic' ? '_blank' : undefined}
    rel={platform !== 'generic' ? 'noopener sponsored' : undefined}
    class:list={['block sm:inline-block w-full sm:w-auto text-center rounded-md px-5 py-3 text-sm font-medium text-white transition-colors', cta.color]}
  >
    {cta.buttonText}
  </a>
</aside>
