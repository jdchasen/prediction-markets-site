---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color: string;
}

const { title, description, href, icon, color } = Astro.props;
---

<a
  href={href}
  class="group rounded-lg border border-gray-200 bg-white p-6 transition-all hover:shadow-md hover:border-gray-300"
>
  <div class:list={['mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg', color]}>
    <Fragment set:html={icon} />
  </div>
  <h3 class="mb-2 text-lg font-semibold text-gray-900 group-hover:text-brand-600">
    {title}
  </h3>
  <p class="text-sm leading-relaxed text-gray-600">
    {description}
  </p>
  <span class="mt-3 inline-block text-sm font-medium text-brand-600 group-hover:text-brand-700">
    Open tool &rarr;
  </span>
</a>
