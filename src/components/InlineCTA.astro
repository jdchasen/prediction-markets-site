---
interface Props {
  platform?: 'kalshi' | 'polymarket' | 'generic';
}

const { platform = 'generic' } = Astro.props;

const KALSHI_REFERRAL = 'https://kalshi.com/sign-up/?referral=f2e21ad4-75b7-4ffb-bfcc-f2fb36e07b21&m=true&utm_source=masterpredictionmarkets&utm_medium=inline-cta&utm_campaign=signup';
const POLYMARKET_REFERRAL = 'https://polymarket.us/1762?utm_source=masterpredictionmarkets&utm_medium=inline-cta&utm_campaign=signup';

const configs: Record<string, { heading: string; text: string; buttonText: string; href: string; borderColor: string; buttonColor: string }> = {
  kalshi: {
    heading: 'Trade This Market on Kalshi',
    text: 'CFTC-regulated event contracts. Deposit with card or bank, trade in minutes.',
    buttonText: 'Sign Up for Kalshi',
    href: KALSHI_REFERRAL,
    borderColor: 'border-green-300 dark:border-green-700',
    buttonColor: 'bg-green-600 hover:bg-green-700',
  },
  polymarket: {
    heading: 'Trade This Market on Polymarket',
    text: 'Crypto-based prediction market with deep liquidity and real-time settlement.',
    buttonText: 'Explore Polymarket',
    href: POLYMARKET_REFERRAL,
    borderColor: 'border-blue-300 dark:border-blue-700',
    buttonColor: 'bg-blue-600 hover:bg-blue-700',
  },
  generic: {
    heading: 'Ready to Trade Prediction Markets?',
    text: 'Compare Kalshi and Polymarket side-by-side — fees, features, and which one fits your style.',
    buttonText: 'Compare Platforms',
    href: '/platforms',
    borderColor: 'border-brand-300 dark:border-brand-700',
    buttonColor: 'bg-brand-600 hover:bg-brand-700',
  },
};

const c = configs[platform];
const isExternal = platform !== 'generic';
---

<aside class:list={['not-prose my-8 rounded-lg border-2 bg-gray-50 dark:bg-gray-800/50 p-5', c.borderColor]}>
  <p class="mb-1 text-base font-semibold text-gray-900 dark:text-gray-100">{c.heading}</p>
  <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">{c.text}</p>
  <a
    href={c.href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener sponsored' : undefined}
    class:list={['inline-block rounded-md px-4 py-2 text-sm font-medium text-white transition-colors', c.buttonColor]}
  >
    {c.buttonText} &rarr;
  </a>
</aside>
